generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Appointment {
  id                 String              @id @default(cuid())
  title              String
  description        String?
  clientId           String?             @map("client_id")
  picId              String?             @map("pic_id")
  projectId          String?             @map("project_id")
  date               DateTime            @db.Date
  startTime          String              @map("start_time")
  endTime            String              @map("end_time")
  duration           Int
  type               MeetingType         @default(online)
  meetingLink        String?             @map("meeting_link")
  location           String?
  status             AppointmentStatus   @default(pending)
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  guestEmail         String?             @map("guest_email")
  guestName          String?             @map("guest_name")
  guestOrganization  String?             @map("guest_organization")
  guestPhone         String?             @map("guest_phone")
  guestPurpose       String?             @map("guest_purpose")
  isGuestAppointment Boolean             @default(false) @map("is_guest_appointment")
  client             UserProfile?        @relation("AppointmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  pic                UserProfile?        @relation("AppointmentPic", fields: [picId], references: [id], onDelete: Cascade)
  project            Project?            @relation(fields: [projectId], references: [id])
  rescheduleRequests RescheduleRequest[]

  @@index([clientId])
  @@index([date])
  @@index([date, startTime])
  @@index([picId])
  @@index([projectId])
  @@index([status])
  @@map("appointments")
}

model Company {
  id            String      @id @default(cuid())
  userId        String      @unique @map("user_id")
  name          String
  website       String?
  description   String?
  industry      String?
  address       String?
  city          String?
  province      String?
  postalCode    String?     @map("postal_code")
  country       String?     @default("Indonesia")
  phone         String?
  email         String?
  taxId         String?     @map("tax_id")
  logo          String?
  contactPerson String?     @map("contact_person")
  contactPhone  String?     @map("contact_phone")
  contactEmail  String?     @map("contact_email")
  isVerified    Boolean     @default(false) @map("is_verified")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  user          UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects      Project[]

  @@index([isVerified])
  @@index([userId])
  @@map("companies")
}

model Conversation {
  id                String      @id @default(cuid())
  clientId          String      @map("client_id")
  picId             String      @map("pic_id")
  projectId         String?     @map("project_id")
  lastMessageAt     DateTime?   @map("last_message_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  clearedByClientAt DateTime?   @map("cleared_by_client_at")
  clearedByPicAt    DateTime?   @map("cleared_by_pic_at")
  client            UserProfile @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Cascade)
  pic               UserProfile @relation("ConversationPic", fields: [picId], references: [id], onDelete: Cascade)
  project           Project?    @relation(fields: [projectId], references: [id])
  messages          Message[]

  @@index([clientId])
  @@index([lastMessageAt])
  @@index([picId])
  @@index([projectId])
  @@map("conversations")
}

model KanbanBoard {
  id        String       @id @default(cuid())
  title     String
  color     String       @default("#3b82f6")
  position  Int
  projectId String       @map("project_id")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     KanbanTask[]

  @@unique([projectId, position])
  @@index([projectId])
  @@index([position])
  @@map("kanban_boards")
}

model KanbanTask {
  id             String             @id @default(cuid())
  title          String
  description    String?
  priority       KanbanTaskPriority @default(MEDIUM)
  assigneeId     String?            @map("assignee_id")
  projectId      String             @map("project_id")
  tags           String[]
  dueDate        DateTime?          @map("due_date")
  estimatedHours Int?               @map("estimated_hours")
  startedAt      DateTime?          @map("started_at")
  completedAt    DateTime?          @map("completed_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  createdBy      String             @map("created_by")
  boardId        String             @map("board_id")
  position       Int
  assignee       UserProfile?       @relation(fields: [assigneeId], references: [id])
  board          KanbanBoard        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([boardId])
  @@index([dueDate])
  @@index([priority])
  @@index([projectId])
  @@map("kanban_tasks")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  senderId       String       @map("sender_id")
  content        String
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  editedAt       DateTime?    @map("edited_at")
  isDeleted      Boolean      @default(false) @map("is_deleted")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         UserProfile  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
  @@index([isDeleted])
  @@index([senderId])
  @@map("messages")
}

model PicAvailability {
  id          String      @id @default(cuid())
  picId       String      @map("pic_id")
  startTime   String      @map("start_time")
  endTime     String      @map("end_time")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  meetingType MeetingType @default(online) @map("meeting_type")
  date        DateTime    @db.Date
  pic         UserProfile @relation(fields: [picId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([picId, date])
  @@index([picId])
  @@map("pic_availabilities")
}

model PicBlockedSlot {
  id        String      @id @default(cuid())
  picId     String      @map("pic_id")
  date      DateTime    @db.Date
  startTime String      @map("start_time")
  endTime   String      @map("end_time")
  reason    String?
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")
  pic       UserProfile @relation(fields: [picId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([picId])
  @@map("pic_blocked_slots")
}

model Project {
  id              String            @id @default(cuid())
  name            String
  description     String?
  clientId        String            @map("client_id")
  picId           String            @map("pic_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  budgetMax       Decimal?          @map("budget_max") @db.Decimal(15, 2)
  budgetMin       Decimal?          @map("budget_min") @db.Decimal(15, 2)
  category        String?
  clientNotes     String?           @map("client_notes")
  complexity      ProjectComplexity @default(MEDIUM)
  deletedAt       DateTime?         @map("deleted_at")
  deliverables    String?
  endDate         DateTime?         @map("end_date")
  estimatedCost   Decimal?          @map("estimated_cost") @db.Decimal(15, 2)
  features        String?
  notes           String?
  priority        ProjectPriority   @default(MEDIUM)
  progress        Int               @default(0)
  requirements    String?
  startDate       DateTime?         @map("start_date")
  technologyStack String?           @map("technology_stack")
  timeline        Int?
  type            ProjectType       @default(OTHER)
  companyId       String?           @map("company_id")
  picApprovalNote String?           @map("pic_approval_note")
  picApprovedAt   DateTime?         @map("pic_approved_at")
  picDeclinedAt   DateTime?         @map("pic_declined_at")
  status          ProjectStatus     @default(PENDING)
  appointments    Appointment[]
  conversations   Conversation[]
  kanbanBoards    KanbanBoard[]
  kanbanTasks     KanbanTask[]
  client          UserProfile       @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Cascade)
  company         Company?          @relation(fields: [companyId], references: [id])
  pic             UserProfile       @relation("ProjectPic", fields: [picId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([companyId])
  @@index([complexity])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([picId])
  @@index([priority])
  @@index([status])
  @@index([type])
  @@map("projects")
}

model RescheduleRequest {
  id             String           @id @default(uuid())
  appointmentId  String           @map("appointment_id")
  requestedById  String           @map("requested_by_id")
  newDate        DateTime         @map("new_date")
  newStartTime   String           @map("new_start_time")
  newEndTime     String           @map("new_end_time")
  reason         String?
  status         RescheduleStatus @default(pending)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  newMeetingLink String?          @map("new_meeting_link")
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  requestedBy    UserProfile      @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([requestedById])
  @@index([status])
  @@map("reschedule_requests")
}

model UserProfile {
  id                    String              @id @default(cuid())
  userId                String              @unique @map("user_id")
  email                 String              @unique
  password              String
  fullname              String
  role                  UserRole            @default(client)
  avatarColor           String?             @map("avatar_color")
  phone                 String?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  googleAccessToken     String?             @map("google_access_token")
  googleRefreshToken    String?             @map("google_refresh_token")
  googleTokenExpiry     DateTime?           @map("google_token_expiry")
  appointmentsAsClient  Appointment[]       @relation("AppointmentClient")
  appointmentsAsPic     Appointment[]       @relation("AppointmentPic")
  auditLogs             AuditLog[]
  company               Company?
  conversationsAsClient Conversation[]      @relation("ConversationClient")
  conversationsAsPic    Conversation[]      @relation("ConversationPic")
  kanbanTasks           KanbanTask[]
  messages              Message[]
  notifications         Notification[]
  picAvailabilities     PicAvailability[]
  picBlockedSlots       PicBlockedSlot[]
  projectsAsClient      Project[]           @relation("ProjectClient")
  projectsAsPic         Project[]           @relation("ProjectPic")
  rescheduleRequests    RescheduleRequest[]

  @@index([email])
  @@index([role])
  @@index([userId])
  @@map("user_profiles")
}

model AuditLog {
  id           String       @id @default(cuid())
  userId       String?      @map("user_id")
  action       String
  entityType   String       @map("entity_type")
  entityId     String?      @map("entity_id")
  details      Json?
  ipAddress    String?      @map("ip_address")
  userAgent    String?      @map("user_agent")
  success      Boolean      @default(true)
  errorMessage String?      @map("error_message")
  createdAt    DateTime     @default(now()) @map("created_at")
  user         UserProfile? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@index([success])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false) @map("is_read")
  actionUrl String?          @map("action_url")
  createdAt DateTime         @default(now()) @map("created_at")
  user      UserProfile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  completed
}

enum KanbanTaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum KanbanTaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum MeetingType {
  online
  offline
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  APPOINTMENT
  MESSAGE
  SYSTEM
}

enum ProjectComplexity {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PENDING
  APPROVED
  DECLINED
  ACTIVE
  COMPLETED
  ON_MAINTAIN
  CANCELLED
}

enum ProjectType {
  WEB_APPLICATION
  MOBILE_APPLICATION
  IOT
  WEB_BANKING
  E_COMMERCE
  ENTERPRISE_SOFTWARE
  CUSTOM_SOFTWARE
  CONSULTATION
  MAINTENANCE
  OTHER
}

enum RescheduleStatus {
  pending
  approved
  rejected
  completed
}

enum UserRole {
  admin
  pic
  client
}
