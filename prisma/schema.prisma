// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// User roles enum
enum UserRole {
  admin
  pic
  client
}

// User profiles table (stores users with password)
model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @default(uuid()) @map("user_id") // UUID for user reference
  email       String   @unique
  password    String // Hashed password (bcrypt)
  fullname    String   @map("fullname")
  role        UserRole @default(client)
  avatarColor String?  @map("avatar_color") // Hex color code (e.g., #3b82f6) for user avatar background
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@index([userId])
  @@map("user_profiles")
}
