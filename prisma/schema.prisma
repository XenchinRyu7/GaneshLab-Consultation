// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// User roles enum
enum UserRole {
  admin
  pic
  client
}

// User profiles table (stores users with password)
model UserProfile {
  id          String   @id @default(uuid())
  userId      String   @unique @default(uuid()) @map("user_id") // UUID for user reference
  email       String   @unique
  password    String // Hashed password (bcrypt)
  fullname    String   @map("fullname")
  role        UserRole @default(client)
  avatarColor String?  @map("avatar_color") // Hex color code (e.g., #3b82f6) for user avatar background
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  projectsAsClient Project[] @relation("ClientProjects")
  projectsAsPIC    Project[] @relation("PICProjects")
  conversationsAsClient Conversation[] @relation("ClientConversations")
  conversationsAsPIC    Conversation[] @relation("PICConversations")
  messages            Message[]

  @@index([email])
  @@index([role])
  @@index([userId])
  @@map("user_profiles")
}

// Project table (links client and PIC)
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  clientId    String   @map("client_id")
  picId       String   @map("pic_id")
  status      String   @default("active") // active, completed, cancelled
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  client       UserProfile @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Cascade)
  pic          UserProfile @relation("PICProjects", fields: [picId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@index([clientId])
  @@index([picId])
  @@index([status])
  @@map("projects")
}

// Conversation table (chat threads)
model Conversation {
  id          String   @id @default(uuid())
  clientId    String   @map("client_id")
  picId       String   @map("pic_id")
  projectId   String?  @map("project_id") // Optional: null for pre-project chats
  lastMessageAt DateTime? @map("last_message_at")
  clearedByClientAt DateTime? @map("cleared_by_client_at") // When client cleared this conversation
  clearedByPICAt DateTime? @map("cleared_by_pic_at") // When PIC cleared this conversation
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  client    UserProfile @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  pic       UserProfile @relation("PICConversations", fields: [picId], references: [id], onDelete: Cascade)
  project   Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]

  // Note: Unique constraint is handled by database indexes (see migration SQL)
  // One conversation per client-PIC pair when projectId is null
  // One conversation per client-PIC-project combination when projectId is not null
  @@index([clientId])
  @@index([picId])
  @@index([projectId])
  @@index([lastMessageAt])
  @@map("conversations")
}

// Message table (individual chat messages)
model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  isDeleted      Boolean  @default(false) @map("is_deleted")
  editedAt       DateTime? @map("edited_at")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       UserProfile  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@index([isDeleted])
  @@map("messages")
}
