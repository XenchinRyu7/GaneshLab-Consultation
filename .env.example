# Database Configuration (Supabase PostgreSQL)
POSTGRES_URL="your-postgres-pooler-url"
POSTGRES_USER="postgres"
POSTGRES_HOST="your-supabase-host"
POSTGRES_PRISMA_URL="your-postgres-pooler-url-with-pgbouncer"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DATABASE="postgres"
POSTGRES_URL_NON_POOLING="your-postgres-direct-url"

# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"  # Required for server-side realtime broadcasts
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Next.js Public Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Authentication Secret for JWT (generate a random string for production)
AUTH_SECRET="your-secret-key-change-in-production"

# Google Calendar Integration
# Get these from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Base URLs (Dynamically handled in production via NEXT_PUBLIC_VERCEL_URL)
# For development, set NEXT_PUBLIC_BASE_URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Vercel Production URL (auto-populated by Vercel in production)
# Leave empty for local development - Vercel will set this automatically
NEXT_PUBLIC_VERCEL_URL=""

# Login URL (Optional - will be auto-generated from base URL if not set)
# For development, you can set this explicitly
NEXT_PUBLIC_LOGIN_URL="http://localhost:3000/auth/login"

# Email Configuration (SMTP)
EMAIL_USER="your-email@gmail.com"
EMAIL_APP_PASSWORD="your-app-password"

# Prisma Configuration (for local development with Prisma Postgres)
DATABASE_URL="prisma+postgres://localhost:xxxx/?api_key=your-api-key"

# Production Note:
# When deploying to Vercel (production/preview), NEXT_PUBLIC_VERCEL_URL will be automatically set.
# The app will use this to construct the correct URLs for your deployment.
# Example production URLs:
# - Main deployment: ganeshlab-consultation-git-pre-release-saeful-rohmans-projects.vercel.app
# - Preview deployment: ganeshlab-consultation-k0h60pf7g-saeful-rohmans-projects.vercel.app
