# Development Dockerfile for GaneshLab Meetly
FROM node:20-alpine

WORKDIR /app

# Install dependencies
RUN apk add --no-cache libc6-compat

# Copy package files
COPY package.json package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy all files
COPY . .

# Generate theme presets
RUN npm run generate:presets

# Expose port
EXPOSE 3000

# Start development server
CMD ["npm", "run", "dev"]

